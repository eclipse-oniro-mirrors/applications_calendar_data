{
  "app": {
    "products": [
      {
        "name": "default",
        "signingConfig": "release",
        "compileSdkVersion": 23,
        "compatibleSdkVersion": 23
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "common",
      "srcPath": "./common"
    },
    {
      "name": "datastructure",
      "srcPath": "./datastructure"
    },
    {
      "name": "datamanager",
      "srcPath": "./datamanager"
    },
    {
      "name": "rrule",
      "srcPath": "./rrule"
    },
    {
      "name": "dataprovider",
      "srcPath": "./dataprovider"
    }
  ]
}